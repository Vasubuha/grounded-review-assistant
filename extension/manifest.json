{
  "manifest_version": 3,
  "name": "RAG Product Assistant",
  "version": "2.0",
  "description": "AI-powered RAG assistant with automatic product detection and side-panel integration for Amazon and Flipkart.",

  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "sidePanel"
  ],

  "host_permissions": [
    "https://*.amazon.in/*",
    "https://*.amazon.com/*",
    "https://*.flipkart.com/*",
    "https://*.amazon.co.in/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.in/*",
        "https://*.amazon.com/*",
        "https://*.flipkart.com/*",
        "https://*.amazon.co.in/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "content/content.js"
      ]
    }
  ],

  "side_panel": {
    "default_path": "sidepanel/side-panel.html"
  },

  "action": {
    "default_popup": "popup/popup.html"
  }
}