{
  "manifest_version": 3,
  "name": "RAG Product Assistant",
  "version": "2.0",
  "description": "AI-powered RAG assistant with automatic product detection and side-panel integration for Amazon and Flipkart.",

  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "sidePanel"
  ],

  "host_permissions": [
    "https://*.amazon.in/*",
    "https://*.amazon.com/*",
    "https://*.amazon.co.in/*",
    "https://*.flipkart.com/*",
    "https://grounded-review-assistant.onrender.com/*",
    "https://grounded-review-assistant-8vb2i5u2n-vasubuhas-projects.vercel.app/*"
  ],

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.in/*",
        "https://*.amazon.com/*",
        "https://*.amazon.co.in/*",
        "https://*.flipkart.com/*"
      ],
      "js": [
        "content/content.js"
      ]
    }
  ],

  "side_panel": {
    "default_path": "sidepanel/side-panel.html"
  },

  "action": {
    "default_popup": "popup/popup.html"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://grounded-review-assistant-8vb2i5u2n-vasubuhas-projects.vercel.app"
  }
}